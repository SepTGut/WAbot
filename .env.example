# Nomor WhatsApp yang dipakai bot (format internasional, contoh: 6281234567890)
WA_PHONE_NUMBER=

# Google Apps Script Web App (untuk sinkronisasi laporan ke Google Sheets)
# Kosongkan kalau belum mau setup -- bot tetap simpan ke Excel lokal saja.
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=

# Gemini API Key (belum dipakai di bot saat ini, untuk pengembangan fitur AI nanti)
GEMINI_API_KEY=